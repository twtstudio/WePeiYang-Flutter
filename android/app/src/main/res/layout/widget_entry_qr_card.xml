<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/entry_qr_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_entry_qr_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/entry_qr_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="入校码"
        android:textColor="#172033"
        android:textSize="16sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/widget_entry_qr_frame"
        android:padding="8dp">

        <ImageView
            android:id="@+id/entry_qr_widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="入校二维码"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/entry_qr_widget_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="点击刷新"
            android:textColor="#7B8494"
            android:textSize="14sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/entry_qr_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="尚未刷新"
        android:textColor="#697386"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/entry_qr_widget_refresh"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_entry_qr_button"
        android:gravity="center"
        android:text="刷新"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
